        "# ---------- PARÁMETROS DEL ALGORITMO ----------\n",
        "PARAMS = {\n",
        "    \"tam_poblacion\": 60,\n",
        "    \"k_torneo\": 3,\n",
        "    \"p_mutacion\": 0.25,      # probabilidad de mover cada satélite\n",
        "    \"sigma_grados\": 5.0,     # tamaño típico del movimiento\n",
        "    \"p_reinicio\": 0.05,      # probabilidad de reubicar un satélite al azar\n",
        "}\n",
        "\n",
        "# ---------- OPERADORES ----------\n",
        "def crear_poblacion(rng, tam):\n",
        "    \"\"\"Array (tam, 8, 2): tam configuraciones aleatorias.\"\"\"\n",
        "    return np.array([crear_configuracion_aleatoria(rng) for _ in range(tam)])\n",
        "\n",
        "def seleccion_torneo(poblacion, fits, rng, k):\n",
        "    \"\"\"Elige k al azar y devuelve (una copia de) la de mayor fitness.\"\"\"\n",
        "    idx = rng.integers(0, len(poblacion), k)\n",
        "    ganador = idx[np.argmax(fits[idx])]\n",
        "    return poblacion[ganador].copy()\n",
        "\n",
        "def cruce(padre_a, padre_b, rng):\n",
        "    \"\"\"Cruce uniforme: cada satélite viene del padre A o del B.\"\"\"\n",
        "    desde_a = rng.random(N_SATELITES) < 0.5\n",
        "    return np.where(desde_a[:, None], padre_a, padre_b)\n",
        "\n",
        "def mutar(config, rng, p_mut, sigma, p_reinicio):\n",
        "    \"\"\"Mueve algunos satélites con ruido y reubica al azar a otros pocos.\"\"\"\n",
        "    nueva = config.copy()\n",
        "    mover = rng.random(N_SATELITES) < p_mut\n",
        "    ruido = rng.normal(0, sigma, (N_SATELITES, 2))\n",
        "    nueva[mover] += ruido[mover]\n",
        "    reiniciar = rng.random(N_SATELITES) < p_reinicio\n",
        "    if reiniciar.any():\n",
        "        nueva[reiniciar] = crear_configuracion_aleatoria(rng)[reiniciar]\n",
        "    nueva[:, 0] = np.clip(nueva[:, 0], -90, 90)           # latitud dentro de rango\n",
        "    nueva[:, 1] = ((nueva[:, 1] + 180) % 360) - 180       # longitud da la vuelta\n",
        "    return nueva\n",
        "\n",
        "# ---------- PRUEBAS ----------\n",
        "rng = np.random.default_rng(1)\n",
        "\n",
        "# Prueba 1: forma y rangos de la población\n",
        "pob = crear_poblacion(rng, PARAMS[\"tam_poblacion\"])\n",
        "print(\"Forma población:\", pob.shape, \"(esperado (60, 8, 2))\")\n",
        "print(\"Lat en [-90,90]:\", pob[:, :, 0].min() >= -90 and pob[:, :, 0].max() <= 90)\n",
        "print(\"Lon en [-180,180]:\", pob[:, :, 1].min() >= -180 and pob[:, :, 1].max() <= 180)\n",
        "\n",
        "# Prueba 2: el cruce solo usa satélites de los padres\n",
        "A = np.zeros((8, 2))\n",
        "B = np.ones((8, 2)) * 50\n",
        "hijo = cruce(A, B, rng)\n",
        "print(\"Hijo (lat de cada satélite):\", hijo[:, 0], \"(solo 0 y 50)\")\n",
        "print(\"Cruce válido:\", set(hijo[:, 0]) <= {0.0, 50.0})\n",
        "\n",
        "# Prueba 3: mutación sin probabilidad no cambia nada; con probabilidad 1 mueve todo\n",
        "base = pob[0]\n",
        "sin_cambio = mutar(base, rng, 0.0, 5.0, 0.0)\n",
        "print(\"p_mut=0 igual al original:\", np.allclose(base, sin_cambio))   # esperado True\n",
        "con_cambio = mutar(base, rng, 1.0, 5.0, 0.0)\n",
        "print(\"p_mut=1 todos cambian:\", np.all(np.any(base != con_cambio, axis=1)))  # esperado True\n",
        "\n",
        "# Prueba 4: mutación en los bordes del mapa respeta los rangos\n",
        "borde = np.array([[89.9, 179.9]] * 8)\n",
        "muta_borde = mutar(borde, rng, 1.0, 20.0, 0.0)\n",
        "print(\"Borde -> lat OK:\", np.all(np.abs(muta_borde[:, 0]) <= 90),\n",
        "      \"| lon OK:\", np.all(np.abs(muta_borde[:, 1]) <= 180))          # esperado True, True\n",
        "\n",
        "# Prueba 5: torneo con k = tamaño de la población devuelve al mejor\n",
        "fits = np.array([fitness(c) for c in pob])\n",
        "ganador = seleccion_torneo(pob, fits, rng, len(pob))\n",
        "print(\"Torneo total elige al mejor:\", np.allclose(ganador, pob[np.argmax(fits)]))  # esperado True\n",
        "print(\"Mejor fitness de la población inicial:\", fits.max())\n",
        "print(\"Válidas en la población inicial:\", int(sum(es_valida(c) for c in pob)), \"de 60\")"
