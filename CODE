        "# ---------- MODELO DE COBERTURA ----------\n",
        "PESOS = {\"Alta\": 3, \"Media\": 2, \"Normal\": 1}\n",
        "R_COB_GRADOS = 10.0                                   # radio de la huella de cada satélite\n",
        "RADIO_REGION_GRADOS = np.degrees(RADIO_REGION_KM / RADIO_TIERRA_KM)  # 300 km ≈ 2.7°\n",
        "PESO_TOTAL = sum(PESOS[r[\"prioridad\"]] for r in REGIONES)\n",
        "\n",
        "def crear_configuracion_aleatoria(rng):\n",
        "    \"\"\"Matriz (8, 2) con [lat, lon] por satélite, distribuidos uniformemente en la esfera.\"\"\"\n",
        "    lat = np.degrees(np.arcsin(rng.uniform(-1, 1, N_SATELITES)))\n",
        "    lon = rng.uniform(-180, 180, N_SATELITES)\n",
        "    return np.column_stack((lat, lon))\n",
        "\n",
        "def regiones_cubiertas(config):\n",
        "    \"\"\"Lista de 6 booleanos: True si la región está cubierta por algún satélite.\"\"\"\n",
        "    cubiertas = []\n",
        "    for r in REGIONES:\n",
        "        d = distancia_angular(r[\"lat\"], r[\"lon\"], config[:, 0], config[:, 1])\n",
        "        cubiertas.append(bool(np.any(d + RADIO_REGION_GRADOS <= R_COB_GRADOS)))\n",
        "    return cubiertas\n",
        "\n",
        "def cobertura_ponderada(config):\n",
        "    \"\"\"Fracción (0 a 1) del peso total de las regiones que quedó cubierta.\"\"\"\n",
        "    cub = regiones_cubiertas(config)\n",
        "    peso = sum(PESOS[r[\"prioridad\"]] for r, c in zip(REGIONES, cub) if c)\n",
        "    return peso / PESO_TOTAL\n",
        "\n",
        "# ---------- PRUEBAS ----------\n",
        "print(\"Radio región en grados:\", RADIO_REGION_GRADOS, \"(esperado ~2.70)\")\n",
        "print(\"Peso total:\", PESO_TOTAL, \"(esperado 13)\")\n",
        "\n",
        "# Prueba 1: un satélite en el centro de cada región + 2 sobrantes\n",
        "centros = [[r[\"lat\"], r[\"lon\"]] for r in REGIONES]\n",
        "config_perfecta = np.array(centros + [[0, 0], [0, 0]])\n",
        "print(\"Perfecta ->\", regiones_cubiertas(config_perfecta), cobertura_ponderada(config_perfecta))  # todas True, 1.0\n",
