        "# ---------- VALIDEZ Y FITNESS ----------\n",
        "ZONAS_PROHIBIDAS = ZONAS_DESECHOS + OBJETOS_OCUPADOS\n",
        "\n",
        "def violaciones(config):\n",
        "    \"\"\"Lista de (índice_satélite, nombre_zona, profundidad_normalizada) por cada invasión.\n",
        "    La profundidad va de 0 (justo en el borde) a 1 (en el centro de la zona).\"\"\"\n",
        "    lista = []\n",
        "    for i, (lat, lon) in enumerate(config):\n",
        "        for zona in ZONAS_PROHIBIDAS:\n",
        "            d = distancia_angular(lat, lon, zona[\"lat\"], zona[\"lon\"])\n",
        "            if d <= zona[\"radio_grados\"]:\n",
        "                profundidad = (zona[\"radio_grados\"] - d) / zona[\"radio_grados\"]\n",
        "                lista.append((i, zona[\"nombre\"], float(profundidad)))\n",
        "    return lista\n",
        "\n",
        "def es_valida(config):\n",
        "    return len(violaciones(config)) == 0\n",
        "\n",
        "def fitness(config):\n",
        "    \"\"\"Válida: cobertura (0 a 1). Inválida: siempre negativa, más negativa si invade más.\"\"\"\n",
        "    cobertura = cobertura_ponderada(config)\n",
        "    viol = violaciones(config)\n",
        "    if not viol:\n",
        "        return cobertura\n",
        "    return cobertura - 1.0 - sum(p for _, _, p in viol)\n",
        "\n",
        "# ---------- PRUEBAS ----------\n",
        "# Prueba 1: la configuración aleatoria del paso anterior (satélite 2 en el Atlántico Norte)\n",
        "print(\"Aleatoria -> violaciones:\", violaciones(config_azar))\n",
