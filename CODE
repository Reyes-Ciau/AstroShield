        "# esperado: 1 violación, índice 2, 'Atlántico Norte', profundidad ~0.33; fitness ~ -1.33\n",
        "\n",
        "# Prueba 2: la configuración perfecta del paso anterior\n",
        "print(\"Perfecta -> válida:\", es_valida(config_perfecta), \"| fitness:\", fitness(config_perfecta))\n",
