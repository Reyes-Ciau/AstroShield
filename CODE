        "# ---------- CICLO EVOLUTIVO ----------\n",
        "def evolucionar(generaciones=100, seed=0, params=PARAMS, n_elite=2, verbose=True):\n",
        "    \"\"\"Ejecuta el algoritmo y devuelve (mejor_config, historial, poblacion_inicial).\"\"\"\n",
        "    rng = np.random.default_rng(seed)\n",
        "    tam = params[\"tam_poblacion\"]\n",
        "    pob = crear_poblacion(rng, tam)\n",
        "    pob_inicial = pob.copy()\n",
        "\n",
        "    historial = {\"mejor\": [], \"promedio\": [], \"validas\": [], \"cobertura_mejor\": []}\n",
        "\n",
