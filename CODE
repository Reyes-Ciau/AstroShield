        "\n",
        "# Prueba 4: satélite a 6° de Yucatán (dentro)\n",
        "config_cerca = np.array([[26.5, -89.0]] + [[0, 0]] * 7)\n",
        "print(\"A 6° ->\", regiones_cubiertas(config_cerca)[0], \"(esperado True)\")\n",
        "\n",
        "# Prueba 5: configuración aleatoria (semilla fija para que sea repetible)\n",
        "rng = np.random.default_rng(42)\n",
        "config_azar = crear_configuracion_aleatoria(rng)\n",
        "print(\"Aleatoria:\\n\", np.round(config_azar, 1))\n",
        "print(\"Cobertura aleatoria:\", cobertura_ponderada(config_azar))"
