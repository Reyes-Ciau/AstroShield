        "import numpy as np\n",
        "\n",
        "# ---------- DATOS DEL PROBLEMA ----------\n",
        "N_SATELITES = 8\n",
        "RADIO_REGION_KM = 300\n",
        "RADIO_TIERRA_KM = 6371.0\n",
        "\n",
        "REGIONES = [\n",
        "    {\"nombre\": \"Península de Yucatán\", \"lat\": 20.5,  \"lon\": -89.0,  \"prioridad\": \"Alta\"},\n",
        "    {\"nombre\": \"Amazonía brasileña\",   \"lat\": -3.5,  \"lon\": -62.0,  \"prioridad\": \"Alta\"},\n",
        "    {\"nombre\": \"California\",           \"lat\": 36.8,  \"lon\": -119.4, \"prioridad\": \"Media\"},\n",
        "    {\"nombre\": \"Sahel\",                \"lat\": 15.0,  \"lon\": 0.0,    \"prioridad\": \"Media\"},\n",
        "    {\"nombre\": \"Japón\",                \"lat\": 36.0,  \"lon\": 138.0,  \"prioridad\": \"Media\"},\n",
        "    {\"nombre\": \"Interior de Australia\",\"lat\": -25.0, \"lon\": 133.0,  \"prioridad\": \"Normal\"},\n",
        "]\n",
        "\n",
        "ZONAS_DESECHOS = [\n",
        "    {\"nombre\": \"Atlántico Norte\", \"lat\": 45.0,  \"lon\": -35.0,  \"radio_grados\": 12},\n",
        "    {\"nombre\": \"Pacífico Sur\",    \"lat\": -30.0, \"lon\": -120.0, \"radio_grados\": 10},\n",
        "    {\"nombre\": \"Región polar norte\", \"lat\": 78.0, \"lon\": 30.0, \"radio_grados\": 8},\n",
        "]\n",
        "\n",
        "OBJETOS_OCUPADOS = [\n",
        "    {\"nombre\": \"Objeto A\", \"lat\": 10.0,  \"lon\": 45.0,  \"radio_grados\": 5},\n",
        "    {\"nombre\": \"Objeto B\", \"lat\": -15.0, \"lon\": 110.0, \"radio_grados\": 5},\n",
        "]\n",
        "\n",
        "# ---------- GEOMETRÍA ----------\n",
        "def distancia_angular(lat1, lon1, lat2, lon2):\n",
        "    \"\"\"Distancia entre dos puntos de la esfera, en grados (fórmula de haversine).\"\"\"\n",
        "    lat1, lon1, lat2, lon2 = map(np.radians, (lat1, lon1, lat2, lon2))\n",
        "    a = (np.sin((lat2 - lat1) / 2) ** 2\n",
        "         + np.cos(lat1) * np.cos(lat2) * np.sin((lon2 - lon1) / 2) ** 2)\n",
        "    return np.degrees(2 * np.arcsin(np.sqrt(np.clip(a, 0, 1))))\n",
        "\n",
        "def grados_a_km(grados):\n",
        "    return np.radians(grados) * RADIO_TIERRA_KM\n",
        "\n",
        "def zona_que_invade(lat, lon):\n",
        "    \"\"\"Devuelve el nombre de la zona prohibida donde cae el punto, o None si es válido.\"\"\"\n",
        "    for zona in ZONAS_DESECHOS + OBJETOS_OCUPADOS:\n",
        "        if distancia_angular(lat, lon, zona[\"lat\"], zona[\"lon\"]) <= zona[\"radio_grados\"]:\n",
        "            return zona[\"nombre\"]\n",
        "    return None\n",
        "\n",
        "# ---------- PRUEBAS ----------\n",
        "print(\"0° a 90° en el ecuador:\", distancia_angular(0, 0, 0, 90))        # esperado 90\n",
        "print(\"Puntos opuestos:\", distancia_angular(0, 0, 0, 180))              # esperado 180\n",
        "print(\"Polo norte a polo sur:\", distancia_angular(90, 0, -90, 0))       # esperado 180\n",
        "print(\"Mismo punto:\", distancia_angular(20.5, -89, 20.5, -89))          # esperado 0\n",
        "print(\"1 grado en km:\", grados_a_km(1))                                 # esperado ~111.2\n",
        "print(\"Punto (45,-35):\", zona_que_invade(45, -35))                      # esperado Atlántico Norte\n",
        "print(\"Punto (10,45):\", zona_que_invade(10, 45))                        # esperado Objeto A\n",
        "print(\"Punto (0,0):\", zona_que_invade(0, 0))                            # esperado None"
      ]
    },
