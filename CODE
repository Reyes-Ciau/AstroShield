        "import json, urllib.request\n",
        "from PIL import Image, ImageDraw\n",
        "\n",
        "# ---------- 1. DESCARGAR EL MAPA DE CONTINENTES ----------\n",
        "URL_TIERRA = \"https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_land.geojson\"\n",
        "try:\n",
        "    with urllib.request.urlopen(URL_TIERRA, timeout=30) as f:\n",
        "        tierra = json.load(f)\n",
        "    print(\"Mapa descargado:\", len(tierra[\"features\"]), \"elementos de tierra\")\n",
        "except Exception as e:\n",
        "    tierra = None\n",
        "    print(\"No se pudo descargar el mapa:\", e, \"-> se usará la Tierra lisa\")\n",
        "\n",
        "# ---------- 2. TEXTURA: MÁSCARA TIERRA / OCÉANO ----------\n",
        "W, H = 1440, 720   # resolución de la máscara (0.25° por píxel)\n",
        "\n",
        "def poligonos(geojson):\n",
        "    \"\"\"Lista de polígonos; cada uno es una lista de anillos [(lon, lat), ...].\"\"\"\n",
        "    salida = []\n",
        "    for feat in geojson[\"features\"]:\n",
        "        g = feat[\"geometry\"]\n",
        "        if g[\"type\"] == \"Polygon\":\n",
        "            salida.append(g[\"coordinates\"])\n",
        "        elif g[\"type\"] == \"MultiPolygon\":\n",
        "            salida.extend(g[\"coordinates\"])\n",
        "    return salida\n",
        "\n",
        "def mascara_tierra(polis):\n",
        "    \"\"\"Matriz booleana (H, W): True donde hay tierra.\"\"\"\n",
        "    img = Image.new(\"L\", (W, H), 0)\n",
        "    d = ImageDraw.Draw(img)\n",
        "    for p in polis:\n",
        "        for k, anillo in enumerate(p):      # el primer anillo es el borde, los demás son huecos (lagos)\n",
        "            pts = [((lo + 180) / 360 * (W - 1), (90 - la) / 180 * (H - 1)) for lo, la in anillo]\n",
        "            d.polygon(pts, fill=255 if k == 0 else 0)\n",
        "    return np.array(img) > 0\n",
        "\n",
        "def es_tierra(mask, lat, lon):\n",
        "    return bool(mask[int(round((90 - lat) / 180 * (H - 1))), int(round((lon + 180) / 360 * (W - 1)))])\n",
        "\n",
        "def superficie_con_textura(mask):\n",
        "    lon = np.linspace(-180, 180, 361)\n",
        "    lat = np.linspace(-90, 90, 181)\n",
        "    LON, LAT = np.meshgrid(lon, lat)\n",
        "    col = np.round((LON + 180) / 360 * (W - 1)).astype(int)\n",
        "    fila = np.round((90 - LAT) / 180 * (H - 1)).astype(int)\n",
        "    hay_tierra = mask[fila, col]\n",
        "    valor = np.where(hay_tierra, np.where(np.abs(LAT) >= 68, 2, 1), 0)   # 0 océano, 1 tierra, 2 hielo\n",
        "    x, y, z = a_xyz(LAT, LON)\n",
        "    escala = [[0, \"#14407a\"], [0.25, \"#14407a\"], [0.25, \"#3c8d4f\"],\n",
        "              [0.75, \"#3c8d4f\"], [0.75, \"#eef4f8\"], [1, \"#eef4f8\"]]\n",
        "    return go.Surface(x=x, y=y, z=z, surfacecolor=valor, colorscale=escala, cmin=0, cmax=2,\n",
        "                      showscale=False, hoverinfo=\"skip\",\n",
        "                      lighting=dict(ambient=0.85, diffuse=0.4, specular=0.05), name=\"Tierra\")\n",
        "\n",
        "def costas(polis):\n",
        "    curvas = []\n",
        "    for p in polis:\n",
        "        lo = np.array([a[0] for a in p[0]])\n",
        "        la = np.array([a[1] for a in p[0]])\n",
        "        curvas.append(a_xyz(la, lo, 1.003))\n",
        "    x, y, z = con_cortes(curvas)\n",
        "    return go.Scatter3d(x=x, y=y, z=z, mode=\"lines\", line=dict(color=\"rgba(255,255,255,0.7)\", width=1.5),\n",
        "                        hoverinfo=\"skip\", showlegend=False, name=\"Costas\")\n",
        "\n",
        "# ---------- 3. FONDO DE GALAXIA ----------\n",
        "rng_cielo = np.random.default_rng(7)\n",
        "\n",
        "def estrellas():\n",
        "    rng = rng_cielo\n",
        "    def en_esfera(n, rmin, rmax):\n",
        "        v = rng.normal(size=(n, 3))\n",
        "        v /= np.linalg.norm(v, axis=1, keepdims=True)\n",
        "        return v * rng.uniform(rmin, rmax, (n, 1))\n",
        "    # banda de la Vía Láctea: un círculo máximo inclinado con algo de dispersión\n",
        "    normal = np.array([0.35, -0.45, 0.82]); normal /= np.linalg.norm(normal)\n",
        "    e1 = np.cross(normal, [0, 0, 1.0]); e1 /= np.linalg.norm(e1)\n",
        "    e2 = np.cross(normal, e1)\n",
        "    def banda(n, ancho):\n",
        "        t = rng.uniform(0, 2 * np.pi, n)\n",
        "        p = np.outer(np.cos(t), e1) + np.outer(np.sin(t), e2) + rng.normal(0, ancho, (n, 1)) * normal\n",
        "        p /= np.linalg.norm(p, axis=1, keepdims=True)\n",
        "        return p * rng.uniform(1.9, 2.3, (n, 1))\n",
        "    fondo, halo, nucleo = en_esfera(1800, 1.9, 2.3), banda(1500, 0.22), banda(2500, 0.09)\n",
        "    return [\n",
        "        go.Scatter3d(x=halo[:, 0], y=halo[:, 1], z=halo[:, 2], mode=\"markers\", hoverinfo=\"skip\", showlegend=False,\n",
        "                     marker=dict(size=7, color=\"#5b3fa8\", opacity=0.07)),\n",
        "        go.Scatter3d(x=nucleo[:, 0], y=nucleo[:, 1], z=nucleo[:, 2], mode=\"markers\", hoverinfo=\"skip\", showlegend=False,\n",
        "                     marker=dict(size=2.2, opacity=0.55, color=rng.uniform(0, 1, len(nucleo)),\n",
        "                                 colorscale=[[0, \"#3f6fd0\"], [0.5, \"#8a6fe0\"], [1, \"#f0b8ff\"]])),\n",
        "        go.Scatter3d(x=fondo[:, 0], y=fondo[:, 1], z=fondo[:, 2], mode=\"markers\", hoverinfo=\"skip\", showlegend=False,\n",
        "                     marker=dict(size=rng.uniform(1, 3.2, len(fondo)), opacity=0.9,\n",
        "                                 color=rng.choice([\"#ffffff\", \"#cfe0ff\", \"#fff1c9\"], len(fondo)))),\n",
        "    ]\n",
        "\n",
        "# ---------- 4. ARMAR LA FIGURA ----------\n",
        "base = trazas_estaticas()              # Tierra lisa, cuadrícula, zonas y círculos de 300 km\n",
        "if tierra is not None:\n",
        "    polis = poligonos(tierra)\n",
        "    mask = mascara_tierra(polis)\n",
        "    base[0] = superficie_con_textura(mask)\n",
        "    base.insert(1, costas(polis))\n",
        "    # Prueba: puntos conocidos deben caer donde corresponde\n",
        "    for nombre, la, lo, esperado in [(\"Yucatán\", 20.5, -89.0, True), (\"Amazonía\", -3.5, -62.0, True),\n",
        "                                     (\"Sahel\", 15.0, 0.0, True), (\"Japón\", 36.0, 138.0, True),\n",
        "                                     (\"Interior Australia\", -25.0, 133.0, True),\n",
        "                                     (\"Atlántico Norte\", 45.0, -35.0, False), (\"Pacífico Sur\", -30.0, -120.0, False)]:\n",
        "        print(f\"  {nombre}: tierra={es_tierra(mask, la, lo)} (esperado {esperado})\")\n",
        "    print(f\"  Fracción de tierra en el mapa: {mask.mean():.2f} (esperado ~0.29)\")\n",
        "\n",
        "for t in base:\n",
        "    if t.name == \"Cuadrícula 30°\":\n",
        "        t.line = dict(color=\"rgba(255,255,255,0.18)\", width=1)\n",
        "    if t.name == \"Radio de 300 km\":\n",
        "        t.line = dict(color=\"white\", width=3)\n",
        "\n",
        "fig = go.Figure()\n",
        "for t in estrellas() + base:\n",
        "    fig.add_trace(t)\n",
        "n_est = len(fig.data)\n",
        "for t in trazas_config(inicial, \"inicial\", \"darkorange\"):\n",
        "    fig.add_trace(t)\n",
        "for t in trazas_config(mejor, \"final\", \"royalblue\"):\n",
        "    fig.add_trace(t)\n",
        "for t in fig.data:\n",
        "    if t.name and t.name.startswith(\"Región NO cubierta\"):\n",
        "        t.marker.color = \"yellow\"\n",
        "\n",
        "vis_inicial = [True] * n_est + [True] * 5 + [False] * 5\n",
        "vis_final = [True] * n_est + [False] * 5 + [True] * 5\n",
        "for t, v in zip(fig.data, vis_final):\n",
        "    t.visible = v\n",
        "\n",
        "eje = dict(range=[-2.5, 2.5], visible=False)\n",
        "fig.update_layout(\n",
        "    title=f\"AstroShield: R_COB = {R_COB_GRADOS:.0f}°, semilla {sem} | inicial {fitness(inicial):.3f} → final {fitness(mejor):.3f}\",\n",
        "    paper_bgcolor=\"#03040a\", font=dict(color=\"white\"),\n",
        "    scene=dict(xaxis=eje, yaxis=eje, zaxis=eje, aspectmode=\"cube\", bgcolor=\"#03040a\",\n",
        "               camera=dict(eye=dict(x=0.5, y=0.5, z=0.3))),\n",
        "    legend=dict(bgcolor=\"rgba(0,0,0,0.35)\"),\n",
        "    updatemenus=[dict(type=\"buttons\", direction=\"right\", x=0.02, y=1.0, bgcolor=\"#1a1f33\",\n",
